rules_version = '2';

// Ninedogs Firestore 보안 규칙
//
// Firebase 콘솔 > Firestore Database > 규칙 에 그대로 붙여넣고 게시한다.
//
// 원칙
//  - 로그인하지 않으면 아무것도 못 읽고 못 쓴다
//  - household 안의 데이터는 그 household 구성원만 본다
//  - 초대 코드를 아는 사람만 들어올 수 있다. 목록을 훑을 수는 없다
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isMemberOf(householdId) {
      return signedIn() && request.auth.uid in
        get(/databases/$(database)/documents/households/$(householdId))
          .data.memberUids;
    }

    // 초대 코드 -> household id.
    //
    // get 만 허용하고 list 는 막는다. 코드를 정확히 아는 사람만 한 건을
    // 집어올 수 있고, 전체를 훑어 남의 코드를 알아낼 수는 없다.
    match /inviteCodes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn();
      allow update, delete: if false;
    }

    match /households/{householdId} {
      allow get: if isMemberOf(householdId);
      allow list: if false;

      // 만들 때는 자기 자신을 구성원으로 넣어야 한다
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.memberUids;

      // 구성원은 자유롭게 고칠 수 있다.
      //
      // 아직 구성원이 아닌 사람은 '자기 uid 를 추가하는 변경'만 허용한다.
      // household id 는 무작위 문자열이고 초대 코드를 통해서만 알 수 있으므로
      // 사실상 코드를 아는 사람만 들어온다.
      allow update: if isMemberOf(householdId)
        || (signedIn()
            && request.resource.data.memberUids
                 == resource.data.memberUids.concat([request.auth.uid])
            && request.resource.data.inviteCode == resource.data.inviteCode);

      allow delete: if false;

      // 구독, 계정 정보, 금고 메타데이터
      match /{document=**} {
        allow read, write: if isMemberOf(householdId);
      }
    }
  }
}
